# Copy to .env and fill in. Never commit .env.

# Neon/Postgres connection used by the app (the pooled URL is fine here).
DATABASE_URL=
# Optional: direct (non-pooled) URL used by drizzle-kit for migrations.
DATABASE_URL_DIRECT=

PORT=3000

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
CODE_HASH_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated Google OAuth client IDs (iOS, Android, web) whose ID tokens are accepted.
GOOGLE_CLIENT_IDS=

# Development only: codes are written to the server log.
MAIL_TRANSPORT=log
SMS_TRANSPORT=log
